# Copy this file to .env, then replace the placeholder value for the provider you use.
# Alternatively, enter your API key in the app's Settings panel; settings are saved to .env.

PROVIDER=Google Gemini
GOOGLE_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MODEL=gemini-2.0-flash
TEMPERATURE=0.7
SYSTEM_PROMPT=
